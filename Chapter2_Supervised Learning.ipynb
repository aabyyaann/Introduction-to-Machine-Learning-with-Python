# ------------------------------------------------------------------------------
# 1. SETUP & UTALITAS AWAL
# ------------------------------------------------------------------------------
# Menginstall mglearn (library visualisasi bawaan buku) jika belum ada di Colab
!pip install mglearn

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import mglearn

from sklearn.model_selection import train_test_split
from sklearn.datasets import load_breast_cancer, fetch_california_housing

# Mengatur kerangka plot agar rapi
%matplotlib inline
sns.set_theme(style="whitegrid")

print("=== LOAD DATASET ===")
# Dataset sintetis bawaan mglearn
X_forge, y_forge = mglearn.datasets.make_forge()
X_wave, y_wave = mglearn.datasets.make_wave(n_samples=40)

# Dataset dunia nyata (Breast Cancer untuk Klasifikasi)
cancer = load_breast_cancer()
print(f"Breast Cancer dataset shape: {cancer.data.shape}")

# Dataset California Housing untuk Regresi (Menggantikan Boston Dataset yang deprecated)
california = fetch_california_housing()
print(f"California Housing dataset shape: {california.data.shape}\n")


# ------------------------------------------------------------------------------
# 2. k-NEAREST NEIGHBORS (k-NN)
# ------------------------------------------------------------------------------
print("=== 2. k-NEAREST NEIGHBORS ===")

# A. k-NN Classification (Forge Dataset)
X_train, X_test, y_train, y_test = train_test_split(X_forge, y_forge, random_state=8)
knn_cls = KNeighborsClassifier(n_neighbors=3).fit(X_train, y_train)

print("[Klasifikasi Forge]")
print(f"Training Accuracy: {knn_cls.score(X_train, y_train):.2f}")
print(f"Test Accuracy: {knn_cls.score(X_test, y_test):.2f}\n")

# B. k-NN Regression (Wave Dataset)
from sklearn.neighbors import KNeighborsClassifier, KNeighborsRegressor
X_train_r, X_test_r, y_train_r, y_test_r = train_test_split(X_wave, y_wave, random_state=0)
knn_reg = KNeighborsRegressor(n_neighbors=3).fit(X_train_r, y_train_r)

print("[Regresi Wave]")
print(f"Training R^2 Score: {knn_reg.score(X_train_r, y_train_r):.2f}")
print(f"Test R^2 Score: {knn_reg.score(X_test_r, y_test_r):.2f}\n")


# ------------------------------------------------------------------------------
# 3. LINEAR MODELS (MODEL LINEAR)
# ------------------------------------------------------------------------------
print("=== 3. LINEAR MODELS FOR REGRESSION & CLASSIFICATION ===")

from sklearn.linear_model import LinearRegression, Ridge, Lasso

# Regresi menggunakan California Housing Dataset
X_train_h, X_test_h, y_train_h, y_test_h = train_test_split(california.data, california.target, random_state=42)

# A. Ordinary Least Squares (OLS)
lr = LinearRegression().fit(X_train_h, y_train_h)
print(f"OLS Training Score: {lr.score(X_train_h, y_train_h):.2f}")
print(f"OLS Test Score: {lr.score(X_test_h, y_test_h):.2f}")

# B. Ridge Regression (L2 Regularization)
ridge = Ridge(alpha=1.0).fit(X_train_h, y_train_h)
print(f"Ridge (alpha=1.0) Test Score: {ridge.score(X_test_h, y_test_h):.2f}")

# C. Lasso Regression (L1 Regularization)
lasso = Lasso(alpha=0.1).fit(X_train_h, y_train_h)
print(f"Lasso (alpha=0.1) Test Score: {lasso.score(X_test_h, y_test_h):.2f}")
print(f"Jumlah fitur yang digunakan Lasso: {np.sum(lasso.coef_ != 0)}\n")

# D. Model Linear Klasifikasi (Logistic Regression & Linear SVM)
from sklearn.linear_model import LogisticRegression
from sklearn.svm import LinearSVC

X_train_c, X_test_c, y_train_c, y_test_c = train_test_split(cancer.data, cancer.target, stratify=cancer.target, random_state=42)

logreg = LogisticRegression(max_iter=10000).fit(X_train_c, y_train_c)
print(f"Logistic Regression Test Accuracy: {logreg.score(X_test_c, y_test_c):.3f}")

linear_svc = LinearSVC(max_iter=10000, dual=False).fit(X_train_c, y_train_c)
print(f"Linear SVM Test Accuracy: {linear_svc.score(X_test_c, y_test_c):.3f}\n")


# ------------------------------------------------------------------------------
# 4. NAIVE BAYES CLASSIFIERS
# ------------------------------------------------------------------------------
print("=== 4. NAIVE BAYES ===")
from sklearn.naive_bayes import GaussianNB

gnb = GaussianNB().fit(X_train_c, y_train_c)
print(f"GaussianNB Training Accuracy: {gnb.score(X_train_c, y_train_c):.3f}")
print(f"GaussianNB Test Accuracy: {gnb.score(X_test_c, y_test_c):.3f}\n")


# ------------------------------------------------------------------------------
# 5. DECISION TREES (POHON KEPUTUSAN)
# ------------------------------------------------------------------------------
print("=== 5. DECISION TREES ===")
from sklearn.tree import DecisionTreeClassifier

# Menerapkan pre-pruning dengan membatasi max_depth=4 untuk mencegah overfitting
tree = DecisionTreeClassifier(max_depth=4, random_state=0).fit(X_train_c, y_train_c)
print(f"Tree Training Accuracy: {tree.score(X_train_c, y_train_c):.3f}")
print(f"Tree Test Accuracy: {tree.score(X_test_c, y_test_c):.3f}")

# Menampilkan Tingkat Kepentingan Fitur (Feature Importance)
importances = pd.DataFrame({'Feature': cancer.feature_names, 'Importance': tree.feature_importances_})
print("\nTop 3 Fitur Paling Berpengaruh di Decision Tree:")
print(importances.sort_values(by='Importance', ascending=False).head(3).to_string(index=False))
print("\n")


# ------------------------------------------------------------------------------
# 6. ENSEMBLES OF DECISION TREES (RANDOM FORESTS & GBDT)
# ------------------------------------------------------------------------------
print("=== 6. ENSEMBLES OF DECISION TREES ===")
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier

# A. Random Forest (Kumpulan pohon keputusan independen secara acak)
rf = RandomForestClassifier(n_estimators=100, random_state=0).fit(X_train_c, y_train_c)
print(f"Random Forest Test Accuracy: {rf.score(X_test_c, y_test_c):.3f}")

# B. Gradient Boosting Decision Trees / GBDT (Pohon sekuensial yang saling mengoreksi)
gbrt = GradientBoostingClassifier(max_depth=1, learning_rate=0.1, random_state=0).fit(X_train_c, y_train_c)
print(f"Gradient Boosting Test Accuracy: {gbrt.score(X_test_c, y_test_c):.3f}\n")


# ------------------------------------------------------------------------------
# 7. KERNELIZED SUPPORT VECTOR MACHINES (SVM) & DATA SCALING
# ------------------------------------------------------------------------------
print("=== 7. KERNELIZED SUPPORT VECTOR MACHINES (SVM) ===")
from sklearn.svm import SVC

# Melakukan penskalaan data secara manual (Min-Max Scaling) karena SVM sangat sensitif terhadap skala fitur
min_on_training = X_train_c.min(axis=0)
range_on_training = (X_train_c - min_on_training).max(axis=0)

X_train_scaled = (X_train_c - min_on_training) / range_on_training
X_test_scaled = (X_test_c - min_on_training) / range_on_training

# Melatih SVM pada data hasil penskalaan
svc = SVC(C=1, gamma='scale').fit(X_train_scaled, y_train_c)
print(f"Scaled SVM Training Accuracy: {svc.score(X_train_scaled, y_train_c):.3f}")
print(f"Scaled SVM Test Accuracy: {svc.score(X_test_scaled, y_test_c):.3f}\n")


# ------------------------------------------------------------------------------
# 8. NEURAL NETWORKS (MULTILAYER PERCEPTRONS - MLP)
# ------------------------------------------------------------------------------
print("=== 8. NEURAL NETWORKS (MLP) ===")
from sklearn.neural_network import MLPClassifier

# Menggunakan data yang sudah diskala dari bagian SVM sebelumnya
mlp = MLPClassifier(max_iter=1000, alpha=1, random_state=0).fit(X_train_scaled, y_train_c)
print(f"MLP Training Accuracy: {mlp.score(X_train_scaled, y_train_c):.3f}")
print(f"MLP Test Accuracy: {mlp.score(X_test_scaled, y_test_c):.3f}\n")

# ------------------------------------------------------------------------------
# 9. VISUALISASI TAMBAHAN (Mengecek Pengaruh Parameter k pada k-NN)
# ------------------------------------------------------------------------------
print("=== 9. PROSES VISUALISASI EVALUASI MODEL (K-NN BIAS-VARIANCE TRADEOFF) ===")
training_accuracy = []
test_accuracy = []
neighbors_settings = range(1, 11)

for n_neighbors in neighbors_settings:
    clf = KNeighborsClassifier(n_neighbors=n_neighbors)
    clf.fit(X_train, y_train)
    training_accuracy.append(clf.score(X_train, y_train))
    test_accuracy.append(clf.score(X_test, y_test))

plt.figure(figsize=(8, 5))
plt.plot(neighbors_settings, training_accuracy, label="training accuracy", marker='o')
plt.plot(neighbors_settings, test_accuracy, label="test accuracy", linestyle='--', marker='x')
plt.ylabel("Accuracy")
plt.xlabel("n_neighbors")
plt.title("k-NN: Hubungan Nilai K terhadap Overfitting & Underfitting")
plt.legend()
plt.show()

print("\n=== EKSEKUSI BERHASIL SELESAI ===")
